      "roundness": null,
      "seed": 309644537,
      "version": 550,
      "versionNonce": 918018199,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1778190302368,
      "link": null,
      "locked": false,
      "text": "An abstraction over\nthe persistence layer.\nThe domain code\nnever touches the DB\ndirectly",
      "fontSize": 36.34793787739133,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "An abstraction over the persistence layer. The domain code never touches the DB directly",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "_Eg_iOfgVhtw0Jp45E8Wd",
      "type": "text",
      "x": 796.7051345095324,
      "y": 74.79942786063384,
