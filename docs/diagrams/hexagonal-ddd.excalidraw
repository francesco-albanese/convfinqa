      "boundElements": null,
      "updated": 1778190302368,
      "link": null,
      "locked": false,
      "text": "The application core sits at the\ncenter, everything external\n(HTTP, DB, CLI, queues, APIs)\nis behind a \"port\" (interface) and\nimplemented by an \"adapter\"\n(concrete class)",
      "fontSize": 54.535623287814865,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "The application core sits at the center, everything external (HTTP, DB, CLI, queues, APIs) is behind a \"port\" (interface) and implemented by an \"adapter\" (concrete class)",
      "autoResize": false,
      "lineHeight": 1.25
    },
