      "text": "The problem space.\nExample: LLM financial\nconversational chat",
      "fontSize": 36.34793787739133,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "The problem space. Example: LLM financial conversational chat",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "c4dNeiC2nWIXCH3v1yY4X",
      "type": "text",
      "x": 90.65421970802839,
      "y": 73.0496240004976,
      "width": 401.5144766584102,
      "height": 227.17461173369583,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
