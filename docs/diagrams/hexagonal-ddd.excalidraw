      "text": "Immutable, no\nidentity, defined by\nits values. Example:\nModelConfig",
      "fontSize": 36.34793787739133,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Immutable, no identity, defined by its values. Example: ModelConfig",
