      "isDeleted": false,
      "boundElements": null,
      "updated": 1778190302368,
      "link": null,
      "locked": false,
      "text": "Business logic that\ndoesn't belong to one\nentity.",
      "fontSize": 36.34793787739133,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Business logic that doesn't belong to one entity.",
